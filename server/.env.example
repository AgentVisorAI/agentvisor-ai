# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Auth ---
# openssl rand -hex 48
JWT_SECRET=change-me-in-production-please-64-hex-chars-of-entropy-required
JWT_ISSUER=agentvisor-ai
JWT_AUDIENCE=agentvisor-console
SESSION_COOKIE_NAME=av_session
SESSION_COOKIE_SECURE=false  # true in production behind HTTPS

# --- Database ---
# Postgres, always. Any provider that speaks the postgres:// protocol works:
#   Local docker-compose : postgres://agentvisor:dev_password_replace_me@localhost:5433/agentvisor
#   Neon                 : postgres://user:pass@ep-xxxxxx.neon.tech/agentvisor?sslmode=require
#   Supabase             : postgres://postgres:pass@db.xxxxx.supabase.co:5432/postgres
#   Fly Postgres         : postgres://postgres:pass@your-app-db.internal:5432
#   AWS RDS              : postgres://user:pass@your-cluster.rds.amazonaws.com:5432/agentvisor
DATABASE_URL=postgres://agentvisor:dev_password_replace_me@localhost:5433/agentvisor

# --- CORS ---
# Comma-separated list of console origins allowed to talk to this API.
ALLOWED_ORIGINS=http://localhost:8787,https://agentvisorai.me,https://agentvisorai.github.io
