# AgentBridge systemd unit.
#
# Install:
#   sudo useradd --system --home /var/lib/agent-bridge --shell /usr/sbin/nologin agent-bridge
#   sudo mkdir -p /var/lib/agent-bridge /etc/agent-bridge
#   sudo cp target/release/agent-bridge /usr/local/bin/
#   sudo cp target/release/abctl /usr/local/bin/
#   cd /etc/agent-bridge && sudo abctl init --preset openai --output agentbridge.toml
#   # Round-18 F1: generate the receipt trust anchor BEFORE first boot.
#   # `ProtectSystem=strict` below mounts /etc read-only, so the harness
#   # cannot auto-create the seed at startup — that would EROFS.
#   sudo -u agent-bridge abctl keygen --output /etc/agent-bridge/signing.seed
#   sudo chmod 400 /etc/agent-bridge/signing.seed
#   sudo chown agent-bridge:agent-bridge /etc/agent-bridge/signing.seed
#   echo 'AB_UPSTREAM_API_KEY=sk-...' | sudo tee /etc/agent-bridge/secrets.env
#   sudo chmod 600 /etc/agent-bridge/secrets.env
#   sudo chown -R agent-bridge:agent-bridge /var/lib/agent-bridge /etc/agent-bridge
#   sudo cp deploy/systemd/agent-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agent-bridge
#
# Check: abctl health --url http://127.0.0.1:8484

[Unit]
Description=AgentBridge LLM proxy with signed receipts
Documentation=https://github.com/AgentVisorAI/agent-bridge
After=network-online.target
Wants=network-online.target
# Round-19 F7: bound the restart-loop budget. Without these, a
# misconfigured AB_CONFIG (bad TOML, port bind conflict) causes
# exit-nonzero → RestartSec=2 → retry, forever. That floods
# journald (systemd-journald throttles a unit at ~1000 msg/30s and
# starts DROPPING messages from unrelated services on the same
# host). StartLimitBurst=5 with StartLimitIntervalSec=60s means
# systemd holds the unit in "failed" after 5 crashes in 1 minute,
# preserving journald capacity for whatever comes next.
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
User=agent-bridge
Group=agent-bridge
WorkingDirectory=/var/lib/agent-bridge
Environment=RUST_LOG=info
Environment=AB_CONFIG=/etc/agent-bridge/agentbridge.toml
# Round-17 F10: the signing seed IS the receipt trust anchor.
# Historically it lived inside WorkingDirectory=/var/lib/agent-bridge,
# which is ReadWritePaths=. Any operator running `sudo cat` /
# rsync backup / debug shell traversed the same tree that held the
# key. Move it to /etc/agent-bridge (read-only config tree),
# owned agent-bridge:agent-bridge, mode 0400. Install docs already
# instruct pre-generating the seed with `abctl keygen`.
Environment=AB_SIGNING_SEED_FILE=/etc/agent-bridge/signing.seed
# API keys live here, mode 0600, never in the unit file:
EnvironmentFile=-/etc/agent-bridge/secrets.env
ExecStart=/usr/local/bin/agent-bridge
Restart=on-failure
RestartSec=2

# Round-18 F3: match the docker-compose (120 s stop_grace_period)
# and k8s (terminationGracePeriodSeconds: 120) shutdown budgets.
# Default systemd DefaultTimeoutStopSec is 90 s on stock installs
# and can be as low as 30 s under distro overrides — either way
# below the harness's documented 4-phase shutdown budget
# (30 s HTTP drain + 30 s worker wait_idle + 30 s finalize_sessions
# + 5 s telemetry flush). SIGKILL mid-finalize drops receipts and
# truncates ATIF trajectories; giving the process 120 s + 5 s slack
# for a clean systemd stop-then-SIGKILL cycle avoids that.
TimeoutStopSec=125s
# Deliver SIGTERM to the process group so any spawned child (rare
# but possible via wasmtime host functions) gets a chance to run
# its own cleanup before SIGKILL. Same posture as k8s.
KillMode=mixed

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# ReadWritePaths does NOT include /etc/agent-bridge on purpose —
# config + signing seed are read-only after install.
ReadWritePaths=/var/lib/agent-bridge
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute=false is required because the WASM policy engine
# (crates/ab-sandbox/src/wasm_policy.rs) uses a Cranelift JIT that maps
# executable-writable memory. Do NOT re-enable this without switching to
# an interpreter-only wasmtime build.
MemoryDenyWriteExecute=false
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
