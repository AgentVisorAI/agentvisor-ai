{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvisor.dev/schemas/receipt-v2.json",
  "title": "AgentVisor AI Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "receipt_id", "session_id", "issued_at", "issued_at_iso", "ai_agent", "subject", "tool_calls", "cost", "stop_reason_id", "stop_reason", "key_id", "public_key_b64", "signature_b64"],
  "properties": {
    "receipt_version": { "const": 2 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "issued_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740992 },
    "issued_at_iso": { "type": "string", "format": "date-time" },
    "ai_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "charter", "instance_uid"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "charter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type_id"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "type_id": { "const": 1 }
          }
        },
        "instance_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ttl_remaining_s": { "type": "integer", "minimum": 0 }
      }
    },
    "subject": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "chain_head", "event_count"], "properties": { "kind": { "const": "event_chain" }, "chain_head": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "event_count": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "trajectory_digest", "step_count", "retroactive"], "properties": { "kind": { "const": "atif_trajectory" }, "trajectory_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "step_count": { "type": "integer", "minimum": 0 }, "retroactive": { "const": true } } }
      ]
    },
    "tool_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "allowed", "blocked"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "allowed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "cached_tokens", "cost_usd_micros"],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd_micros": { "type": "integer", "minimum": 0 }
      }
    },
    "stop_reason_id": { "type": "integer", "minimum": 0, "maximum": 255 },
    "stop_reason": { "type": "string" },
    "key_id": { "type": "string", "minLength": 1 },
    "public_key_b64": { "type": "string", "minLength": 1 },
    "signature_b64": { "type": "string", "minLength": 1 }
  }
}
