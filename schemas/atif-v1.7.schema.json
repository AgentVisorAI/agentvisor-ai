{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentvisor.dev/schemas/atif-v1.7.json",
  "title": "ATIF v1.7 Trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent", "steps"],
  "properties": {
    "schema_version": { "const": "ATIF-v1.7" },
    "session_id": { "type": "string", "maxLength": 128 },
    "trajectory_id": { "type": "string", "maxLength": 128 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string" },
        "tool_definitions": {
          "type": "array",
          "maxItems": 512,
          "items": { "type": "object", "maxProperties": 128 }
        },
        "extra": {}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "source", "message"],
        "properties": {
          "step_id": { "type": "integer", "minimum": 1 },
          "timestamp": { "type": "string", "format": "date-time" },
          "source": { "enum": ["system", "user", "agent"] },
          "message": { "oneOf": [{ "type": "string" }, { "type": "array" }] },
          "reasoning_effort": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
          "reasoning_content": { "type": "string" },
          "model_name": { "type": "string" },
          "tool_calls": { "type": "array" },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["results"],
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_call_id": { "type": "string" },
                    "content": { "oneOf": [{ "type": "string" }, { "type": "array" }] },
                    "subagent_trajectory_ref": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "trajectory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "session_id": { "type": "string", "maxLength": 128 },
                          "trajectory_path": { "type": "string", "minLength": 1 },
                          "extra": { "type": "object" }
                        },
                        "anyOf": [
                          { "required": ["trajectory_id"] },
                          { "required": ["trajectory_path"] }
                        ]
                      }
                    },
                    "extra": { "type": "object" }
                  }
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prompt_tokens": { "type": "integer", "minimum": 0 },
              "completion_tokens": { "type": "integer", "minimum": 0 },
              "cached_tokens": { "type": "integer", "minimum": 0 },
              "cost_usd": { "type": "number", "minimum": 0, "maximum": 9e9 },
              "logprobs": {
                "type": "array",
                "items": { "type": "number" }
              },
              "completion_token_ids": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "prompt_token_ids": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "extra": { "type": "object" }
            }
          },
          "is_copied_context": { "type": "boolean" },
          "llm_call_count": { "type": "integer", "minimum": 0 },
          "extra": {}
        }
      }
    },
    "notes": { "type": "string" },
    "final_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_prompt_tokens": { "type": "integer", "minimum": 0 },
        "total_completion_tokens": { "type": "integer", "minimum": 0 },
        "total_cached_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0, "maximum": 9e9 },
        "total_steps": { "type": "integer", "minimum": 0 },
        "extra": { "type": "object" }
      }
    },
    "continued_trajectory_ref": { "type": "string", "maxLength": 128 },
    "subagent_trajectories": { "type": "array", "items": { "allOf": [{ "$ref": "#" }, { "required": ["trajectory_id"] }] } },
    "extra": {}
  }
}
