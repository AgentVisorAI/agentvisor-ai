{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "revision"],
  "properties": {
    "environment": { "enum": ["staging", "production"] },
    "revision": { "type": "string", "minLength": 7, "maxLength": 128 }
  }
}
