# Cloudflare Pages / Netlify security headers for the console SPA.
#
# The SPA is a single-page app that talks JSON + SSE to an API on a
# separate origin. Everything below is a defense-in-depth cap: even if
# an XSS payload landed in a customer-supplied event body, this policy
# denies script/frame/object loads outright and blocks connections to
# arbitrary origins.

/*
  # Content Security Policy — strict allow-list.
  #   • script-src 'self' — no inline scripts, no external CDN.
  #   • connect-src is the same-origin API and its EventSource. Adjust
  #     if you deploy the API on a different host.
  #   • frame-ancestors 'none' — clickjacking protection.
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.agentvisorai.me; img-src 'self' data:; font-src 'self' data:; manifest-src 'self'; object-src 'none'
  # 2-year HSTS with subdomain + preload. Cloudflare handles TLS.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  # Isolate the SPA from cross-origin frames + windows (post-Spectre).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Cross-Origin-Embedder-Policy: require-corp

# The API responses set their own strict CSP + HSTS via helmet — nothing
# to add here beyond the SPA defaults above.

/.well-known/*
  # security.txt + related well-known files are meant to be public.
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
